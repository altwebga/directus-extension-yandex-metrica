{
	"name": "directus-extension-yandex-metrica",
	"description": "Send CRM orders from Directus to Yandex Metrica: OAuth connection, counter selection and scheduled order upload",
	"icon": "analytics",
	"version": "1.0.1",
	"author": "Konstantin <altwebga@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/altwebga/directus-extension-yandex-metrica.git"
	},
	"homepage": "https://github.com/altwebga/directus-extension-yandex-metrica#readme",
	"bugs": {
		"url": "https://github.com/altwebga/directus-extension-yandex-metrica/issues"
	},
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-bundle",
		"directus-custom-bundle",
		"yandex",
		"yandex-metrica",
		"yandex-metrika",
		"metrika",
		"crm",
		"analytics",
		"offline-conversions"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"directus:extension": {
		"type": "bundle",
		"path": {
			"app": "dist/app.js",
			"api": "dist/api.js"
		},
		"entries": [
			{
				"type": "module",
				"name": "yandex-metrica",
				"source": "src/module/index.ts"
			},
			{
				"type": "endpoint",
				"name": "metrika",
				"source": "src/endpoint.ts"
			},
			{
				"type": "hook",
				"name": "metrika-sync",
				"source": "src/hook.ts"
			}
		],
		"host": "^12.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate",
		"add": "directus-extension add",
		"typecheck": "vue-tsc --noEmit",
		"prepublishOnly": "npm run typecheck && npm run build && npm run validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "18.0.2",
		"typescript": "^5.9.0",
		"vue": "3.5.24",
		"vue-tsc": "^3.1.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
